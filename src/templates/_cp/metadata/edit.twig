{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}
{% import "saml-core/_cp/metadata/_macros/utils" as utils %}

{% set fullPageForm=1 %}

{% set tabs = {
    security: {
        id:'security',
        class: 'security',
        url: '#security',
        label: 'Security'
    },
    configure: {
        id:'configure',
        class: 'configure',
        url: '#configure',
        label: 'Configure'
    },
    metadata: {
        id: 'metadata',
        class: 'metadata',
        url: '#metadata',
        label: 'Metadata'
    },
} %}

{% block details %}
    <input type="hidden" name="providerType" value="{{ provider.id ? provider.type : createType }}">
    <dl class="meta read-only">
        <div class="data">
            <dt class="heading">{{ "Status"|t('app') }}</dt>
            <dd class="value flex">
                <div class="flex-grow">
                    <span class="status {% if provider.enabled %}active{% else %}inactive{% endif %}"></span>
                    {{ provider.enabled ? "Enabled"|t('app') : "Disabled"|t('app') }}
                </div>
                {% if actions|length %}
                    <div>
                        <button type="button" id="action-menubtn" class="btn menubtn" data-icon="settings"
                                title="{{ 'Actions'|t('app') }}" aria-label="{{ 'Actions'|t('app') }}"></button>
                        <div class="menu">
                            {% for actionList in actions %}
                                {% if not loop.first %}<hr>{% endif %}
                                <ul>
                                    {% for actionItem in actionList %}
                                        <li><a
                                                {%- if actionItem.id is defined %} id="{{ actionItem.id }}"{% endif %}
                                                {%- if actionItem.action is defined %} class="formsubmit" data-action="{{ actionItem.action }}"{% endif -%}
                                            >{{ actionItem.label }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endfor %}
                        </div>
                        <div id="action-spinner" class="spinner hidden"></div>
                    </div>
                {% endif %}
            </dd>
        </div>
    </dl>

    <div class="meta">
        {% set ownEntity = myType == provider.type or myType == createType %}
        {{ forms.textField({
            label: "Entity ID"|t(plugin.handle),
            instructions: "The unique ID for this provider."|t(plugin.handle),
            name: "entityId",
            id: 'entityId',
            class: "code",
            value: ownEntity ? (provider.entityId ?: ownEntityId) : provider.entityId,
            errors: provider.getErrors('entityId'),
            required: true,
            readonly: not ownEntity,
            disabled: not ownEntity,
        }) }}

        {% if ownEntity %}
            {% set sites = [] %}
            {% for site in craft.app.sites.allSites() %}
                {% set sites = sites|merge([{
                    label: site.name,
                    value: site.id,
                }]) %}
            {% endfor %}
            {{ forms.selectField({
                label: "Site"|t('app'),
                instructions: "The Craft site this provider is associated with."|t(plugin.handle),
                id: 'providerSite',
                name: 'providerSite',
                value: provider.id ? provider.siteId : '',
                errors: provider.getErrors('site'),
                options: sites,
                required: true,
            }) }}
        {% endif %}
    </div>

    {% if provider.id %}
        <dl class="meta read-only">
            <div class="data">
                <dt class="heading">{{ "Created at"|t('app') }}</dt>
                <dd class="value">{{ provider.dateCreated|datetime('short') }}</dd>
            </div>
            <div class="data">
                <dt class="heading">{{ "Updated at"|t('app') }}</dt>
                <dd class="value">{{ provider.dateUpdated|datetime('short') }}</dd>
            </div>
        </dl>
    {% endif %}
{% endblock %}

{% block content %}
    <input type="hidden" name="action"
           value="{{ baseActionPath }}/metadata/{% if createType == myType or myType == provider.type %}auto-create{% else %}save{% endif %}">
    {{ redirectInput(baseCpPath ~ '/metadata/') }}
    {% if provider.id %}<input type="hidden" name="identifier" value="{{ provider.id }}">{% endif %}

    {{ forms.textField({
        first: true,
        label: "Label"|t(plugin.handle),
        instructions: "Friendly name for the provider. You can use the provider's name (like `OKTA`) or the environment (`DEV`) so everyone knows its purpose."|t(plugin.handle),
        name: "label",
        id: 'label',
        required: true,
        value: provider.label,
        errors: provider.getErrors('label'),
    }) }}

    <div id="security">
        {% if createType == myType %}
            <hr>

            {% embed '_includes/forms/field' with {
                label: "Key Pair"|t(plugin.handle),
                instructions: "Changing the key pair means exchanging the new certificate with the other provider. Assigning a key pair is highly recommended."|t(plugin.handle),
                id: 'keychain',
                required: true,
                errors: provider.getErrors('keychain'),
            } %}
                {% block input %}
                    {% import '_includes/forms' as forms %}
                    <div class="flex">
                        {{ forms.select({
                            id: 'keychain',
                            name: 'keychain',
                            value: provider.keychain ? provider.keychain.id : '',
                            options: allkeypairs|merge([{label: 'None'|t('app'), value: null}]),
                        }) }}
                        <button type="button" id="generate-key" class="btn add icon">{{ "Generate key pair"|t(plugin.handle) }}</button>
                    </div>
                {% endblock %}
            {% endembed %}

            <div class="buttons">
                {% if provider.keychain %}
                    <a class="btn" data-icon="download" target="_blank"
                       href="{{ actionUrl(plugin.handle ~ '/metadata/download-certificate', {keyId: provider.keychain.id}) }}">{{ "Download certificate"|t(plugin.handle) }}</a>
                {% endif %}
                <a class="btn" href="{{ cpUrl(plugin.handle ~ '/keychain') }}">{{ "Manage key pairs"|t(plugin.handle) }}</a>
            </div>

            {% do view.registerAssetBundle("flipbox\\keychain\\web\\assets\\bundles\\GenerateKeyPair") %}
            {% js %}
                new Craft.GenerateKeyPair(
                    $('#generate-key'),
                    $('#keychain'),
                    "{{ plugin.handle|e('js') }}"
                );
            {% endjs %}
        {% endif %}

        {% if myType == 'idp' and provider.type == 'sp' %}
            <hr>
            <h2>{{ "Encryption"|t(plugin.handle) }}</h2>
            {{ forms.lightswitchField({
                label: "Encrypt Assertions"|t(plugin.handle),
                instructions: "Encrypt assertions sent to this Service Provider."|t(plugin.handle),
                id: 'encryptAssertions',
                name: 'encryptAssertions',
                on: provider.encryptAssertions,
                errors: provider.getErrors('encryptAssertion'),
            }) }}
        {% endif %}
    </div>

    <div id="configure" class="hidden">
        {% if (( myType == 'sp' and provider.isIdentityProvider() ) or ( myType == 'idp' and provider.isServiceProvider() )) and provider.loginPath %}
            <hr>
            <h2>{{ "Login/Logout Paths"|t(plugin.handle) }}</h2>
            {{ forms.copytextField({
                label: "Login Path"|t(plugin.handle),
                instructions: myType == 'sp' ?
                    "Use this as the `loginPath` value in the `general.php` configuration file."|t(plugin.handle) :
                    "Go to this URL to start IdP-initiated login with this Service Provider. [More info](https://saml-idp.flipboxfactory.com/initiating-sso.html#identity-provider-idp-initiated)"|t(plugin.handle),
                id: 'loginPath',
                class: 'code',
                value: (myType == 'sp' and provider.isIdentityProvider()) ? provider.loginRequestPath : provider.getLoginRequestEndpoint(),
            }) }}

            {{ forms.copytextField({
                label: "Logout Path"|t(plugin.handle),
                instructions: "Use this URL to initiate Single Logout (SLO) with this provider."|t(plugin.handle),
                id: 'logoutPath',
                class: 'code',
                value: (myType == 'sp' and provider.isIdentityProvider()) ? provider.logoutRequestPath : provider.getLogoutRequestEndpoint(),
            }) }}
        {% endif %}

        {% if (myType == 'sp' and provider.type == 'idp') or (myType == 'idp' and provider.type == 'sp') %}
            {% import 'saml-core/_cp/metadata/_macros/mapping' as map %}
            {{ map.mappingInputTable(provider, plugin) }}
        {% endif %}

        {% if (myType == 'idp' and provider.type == 'sp') %}
            {% import 'saml-core/_cp/metadata/_macros/groups' as groups %}
            <hr>
            <h2>{{ "Groups"|t(plugin.handle) }}</h2>
            {{ groups.syncOptions(provider, plugin) }}
            {{ groups.conditionalAllow(provider, plugin) }}
        {% endif %}
    </div>

    <div id="metadata" class="hidden">
        <hr>
        <h2>{{ "Metadata"|t(plugin.handle) }}</h2>

        {% if createType != myType %}
            <p>{{ "Provide the metadata in one of the following ways."|t(plugin.handle) }}</p>
            {{ forms.textField({
                label: "Metadata URL"|t(plugin.handle),
                instructions: "If the URL is public, the metadata is fetched on save. Useful if the metadata or certificates change often: save again to refresh it."|t(plugin.handle),
                id: 'metadata-url-text',
                name: 'metadata-url-text',
                class: 'code',
                autocomplete: false,
                value: provider.getMetadataOptions().url,
                errors: provider.getErrors('metadata-url-text'),
            }) }}
        {% endif %}

        {% embed '_includes/forms/field' with {
            label: "Metadata XML"|t(plugin.handle),
            instructions: createType == myType ?
                "Share this XML with the other provider."|t(plugin.handle) :
                "Paste the provider's metadata XML. It's overwritten when a metadata URL is set."|t(plugin.handle),
            id: 'metadata-text',
            errors: provider.getErrors('metadata-text'),
        } %}
            {% block input %}
                {% import '_includes/forms' as forms %}
                {% import "saml-core/_cp/metadata/_macros/utils" as utils %}
                {{ forms.textarea({
                    class: 'code',
                    id: 'metadata-text',
                    name: 'metadata-text',
                    value: createType == myType and not provider.metadata ? 'This field is created automatically.'|t(plugin.handle) : provider.metadata,
                    readonly: createType == myType,
                    disabled: createType == myType,
                    rows: 10,
                }) }}
                {% if createType == myType %}
                    <div class="buttons">
                        {{ utils.copyFieldContents('metadata-text') }}
                    </div>
                {% endif %}
            {% endblock %}
        {% endembed %}

        {% if provider.id and (singleSignOnServices or assertionConsumerServices or singleLogoutServices) %}
            <hr>
            <h2>{{ "Bindings"|t(plugin.handle) }}</h2>
            {% for binding, url in singleSignOnServices ?: [] %}
                {{ forms.copytextField({
                    label: "Single Sign-On Service (SSO)"|t(plugin.handle),
                    instructions: "Binding: `" ~ binding ~ "`",
                    id: 'sso-' ~ loop.index,
                    class: 'code',
                    value: url,
                }) }}
            {% endfor %}
            {% for binding, url in assertionConsumerServices ?: [] %}
                {{ forms.copytextField({
                    label: "Assertion Consumer Service (ACS)"|t(plugin.handle),
                    instructions: "Binding: `" ~ binding ~ "`",
                    id: 'acs-' ~ loop.index,
                    class: 'code',
                    value: url,
                }) }}
            {% endfor %}
            {% for binding, url in singleLogoutServices ?: [] %}
                {{ forms.copytextField({
                    label: "Single Logout Service (SLO)"|t(plugin.handle),
                    instructions: "Binding: `" ~ binding ~ "`",
                    id: 'slo-' ~ loop.index,
                    class: 'code',
                    value: url,
                }) }}
            {% endfor %}
        {% endif %}
    </div>
{% endblock %}
