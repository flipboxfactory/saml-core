{% macro mappingInputTable(provider, plugin) %}
    {% import '_includes/forms' as craftForms %}
    {% import _self as forms %}

    {% if provider.getType() == constant('\\flipbox\\saml\\core\\models\\SettingsInterface::SP') and plugin.settings.isIDP() %}
        {{ forms.nameIdSection(provider, plugin) }}
    {% endif %}

    {% if provider.getType() == constant('\\flipbox\\saml\\core\\models\\SettingsInterface::IDP') and plugin.settings.isSP() %}
        {{ forms.nameIdSectionForSP(provider, plugin) }}
    {% endif %}

    <hr>
    <h2>{{ "Mapping"|t(plugin.handle) }}</h2>

    {% set cols = {
        attributeName: {
            type: 'text',
            heading: 'Attribute Name'|t(plugin.handle),
        },
        craftProperty: {
            type: 'select',
            heading: 'Craft User Property'|t(plugin.handle),
            options: craft.samlCp.getMappingFieldOptions(
                plugin.settings.isIDP()
            ),
        },
    } %}

    {% if plugin.settings.isIDP() %}
        {% set cols = cols | merge({
            templateOverride: {
                type: 'singleline',
                heading: 'Template Override'|t(plugin.handle),
            }
        }) %}
    {% endif %}

    {{ forms.editableTableField({
        label: "User Attribute Mapping"|t(plugin.handle),
        instructions: plugin.settings.isIDP() ?
            "Map Craft user properties and fields to the SAML assertion attributes sent to the Service Provider, one per row. A **Template Override** works like an [entry URI format](https://craftcms.com/docs/5.x/reference/element-types/entries.html#entry-uri-formats): it can use Twig to build the value, and overrides the **Craft User Property** column."|t(plugin.handle) :
            "Map the SAML assertion attributes to Craft user properties and fields, one per row."|t(plugin.handle),
        id: 'mapping',
        name: 'mapping',
        addRowLabel: "Add a mapping"|t(plugin.handle),
        cols: cols,
        rows: provider.getMapping(),
        fullWidth: true,
        allowAdd: true,
        allowDelete: true,
        allowReorder: true,
        errors: provider.getErrors('mapping')
    }) }}

    {% if provider.getType() == constant('\\flipbox\\saml\\core\\models\\SettingsInterface::SP') and plugin.settings.isIDP() %}
        {% embed '_includes/forms/field' with {
            label: "Preview Mapping"|t(plugin.handle),
            instructions: "Enter a user ID to preview the SAML assertion for that user. Save first to preview your latest changes."|t(plugin.handle),
            id: 'userId',
        } %}
            {% block input %}
                {% import '_includes/forms' as craftForms %}
                <div class="flex">
                    {{ craftForms.text({
                        name: 'userId',
                        id: 'userId',
                        value: currentUser.id,
                        size: 10,
                    }) }}
                    <button type="button" id="show-mapping-preview" class="btn">{{ "Preview"|t('app') }}</button>
                </div>
            {% endblock %}
        {% endembed %}
        <pre class="highlight hidden"><code id="preview-mapping" class="language-xml"></code></pre>

        {# Craft's bundled highlighter: Prism before Craft 5.12, a Prism-compatible shim from 5.12 #}
        {% do view.registerAssetBundle("craft\\web\\assets\\prismjs\\PrismJsAsset") %}
        {% do view.registerAssetBundle("flipbox\\saml\\core\\web\\assets\\bundles\\SamlCore") %}
        {% js %}
            new Craft.SamlCoreMappingPreview(
                $('#show-mapping-preview'),
                $('#preview-mapping'),
                '{{ plugin.handle|e('js') }}',
                '{{ provider.id|e('js') }}',
                $('#userId')
            );
        {% endjs %}
    {% endif %}
{% endmacro %}

{% macro editableTableField(config) %}
    {% import '_includes/forms' as forms %}
    {{ forms.editableTableField(config) }}
{% endmacro %}

{% macro nameIdSectionForSP(provider, plugin) %}
    {% import '_includes/forms' as forms %}
    <hr>
    <h2>{{ "Username/NameID Override"|t(plugin.handle) }}</h2>

    {{ forms.textField({
        label: "NameID Override"|t(plugin.handle),
        instructions: "By default, the NameID is used as the Craft user's username. To use a different value, enter the name of an assertion attribute sent in the SAML Response."|t(plugin.handle),
        id: 'nameIdOverride',
        name: 'nameIdOverride',
        class: 'code',
        placeholder: "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress",
        value: provider.nameIdOverride,
        errors: provider.getErrors('nameIdOverride')
    }) }}
{% endmacro %}

{% macro nameIdSection(provider, plugin) %}
    {% import '_includes/forms' as forms %}
    <hr>
    <h2>{{ "NameID"|t(plugin.handle) }}</h2>

    {{ forms.autosuggestField({
        label: "NameID Override"|t(plugin.handle),
        instructions: "The NameID is the unique identifier the Service Provider uses for the user, like a username. Build it from Craft user properties. It works like an [entry URI format](https://craftcms.com/docs/5.x/reference/element-types/entries.html#entry-uri-formats), so it can use Twig."|t(plugin.handle),
        id: 'nameIdOverride',
        name: 'nameIdOverride',
        class: 'code',
        placeholder: "{username}",
        value: provider.nameIdOverride,
        suggestions: craft.samlCp.getMappingAutoSuggestions(),
        errors: provider.getErrors('nameIdOverride')
    }) }}
{% endmacro %}
