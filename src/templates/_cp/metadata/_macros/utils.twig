{% macro copyFieldContents(textId) %}
    {% set copyButtonId = 'copy-' ~ textId %}
    <button type="button" id="{{ copyButtonId }}" class="btn" data-icon="clipboard">{{ 'Copy to clipboard'|t('app') }}</button>
    {% js %}
        (() => {
            const field = document.getElementById('{{ textId|namespaceInputId|e('js') }}');
            document.getElementById('{{ copyButtonId|namespaceInputId|e('js') }}').addEventListener('click', () => {
                const notice = () => Craft.cp.displayNotice("{{ 'Copied to clipboard.'|t('app')|e('js') }}");
                if (navigator.clipboard) {
                    navigator.clipboard.writeText(field.value)
                        .then(notice)
                        .catch(() => Craft.cp.displayError("{{ 'Couldn’t copy to clipboard.'|t('app')|e('js') }}"));
                } else {
                    field.select();
                    document.execCommand('copy');
                    notice();
                }
            });
        })();
    {% endjs %}
{% endmacro %}
