{% extends "_layouts/cp" %}

{% macro providerTable(providers, myProvider, plugin, emptyMessage) %}
    {% if providers|length %}
        <table class="data fullwidth collapsible">
            <thead>
            <tr>
                <th scope="col">{{ "Label"|t(plugin.handle) }}</th>
                <th scope="col">{{ "Entity ID"|t(plugin.handle) }}</th>
                <th scope="col">{{ "Date Created"|t('app') }}</th>
                <th scope="col">{{ "Date Updated"|t('app') }}</th>
                <th scope="col">{{ "UID"|t('app') }}</th>
            </tr>
            </thead>
            <tbody>
            {% for provider in providers %}
                {% set isMine = myProvider and myProvider.id == provider.id %}
                <tr>
                    <th scope="row" data-title="{{ 'Label'|t(plugin.handle) }}">
                        <span class="status {{ provider.enabled ? 'active' : 'inactive' }}"
                              title="{{ provider.enabled ? 'Enabled'|t('app') : 'Disabled'|t('app') }}"></span>
                        <a href="{{ cpUrl(plugin.handle ~ '/metadata/' ~ (isMine ? 'my-provider' : provider.id)) }}">{{ provider.label ?? 'Provider'|t(plugin.handle) }}</a>
                        {% if isMine %}<span class="light">({{ "My Provider"|t(plugin.handle) }})</span>{% endif %}
                    </th>
                    <td data-title="{{ 'Entity ID'|t(plugin.handle) }}"><code>{{ provider.entityId }}</code></td>
                    <td data-title="{{ 'Date Created'|t('app') }}">{{ provider.dateCreated|date('short') }}</td>
                    <td data-title="{{ 'Date Updated'|t('app') }}">{{ provider.dateUpdated|date('short') }}</td>
                    <td data-title="{{ 'UID'|t('app') }}"><code class="light">{{ provider.uid }}</code></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="zilch small">{{ emptyMessage }}</p>
    {% endif %}
{% endmacro %}

{% block content %}
    <h2>{{ "Service Providers"|t(plugin.handle) }}</h2>
    {% if spListInstructions %}<p>{{ spListInstructions }}</p>{% endif %}
    {{ _self.providerTable(spProviders, myProvider, plugin, "No service providers exist yet."|t(plugin.handle)) }}
    <div class="buttons">
        <a href="{{ cpUrl(plugin.handle ~ '/metadata/new-sp') }}" class="btn add icon">{{ "New service provider"|t(plugin.handle) }}</a>
    </div>

    <hr>

    <h2>{{ "Identity Providers"|t(plugin.handle) }}</h2>
    {% if idpListInstructions %}<p>{{ idpListInstructions }}</p>{% endif %}
    {{ _self.providerTable(idpProviders, myProvider, plugin, "No identity providers exist yet."|t(plugin.handle)) }}
    <div class="buttons">
        <a href="{{ cpUrl(plugin.handle ~ '/metadata/new-idp') }}" class="btn add icon">{{ "New identity provider"|t(plugin.handle) }}</a>
    </div>
{% endblock %}
