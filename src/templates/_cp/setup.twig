{% extends "_layouts/cp" %}

{% block content %}
    <h2>{{ "Getting Started"|t(plugin.handle) }}</h2>
    <ol>
        <li>
            <a href="{{ cpUrl(baseCpPath ~ '/metadata/my-provider') }}" class="go">{{ "Create your metadata"|t(plugin.handle) }}</a>
        </li>
        <li>
            <a href="{{ cpUrl(baseCpPath ~ '/metadata/new-' ~ plugin.settings.remoteType) }}" class="go">{{ "Install the {type}’s metadata"|t(plugin.handle, {type: plugin.settings.remoteType|upper}) }}</a>
        </li>
    </ol>
{% endblock %}

{% block details %}
    {% if ownProvider %}
        <dl class="meta read-only">
            <div class="data">
                <dt class="heading">{{ "Entity ID"|t(plugin.handle) }}</dt>
                <dd class="value"><code>{{ ownProvider.entityId }}</code></dd>
            </div>
        </dl>
    {% endif %}
{% endblock %}
