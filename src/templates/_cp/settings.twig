{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% block content %}
    {% if not craft.app.config.general.allowAdminChanges %}
        {% exit 403 %}
    {% endif %}
    <input type="hidden" name="action" value="{{ baseActionPath }}/save">
    {{ redirectInput(baseCpPath) }}

    {% set warning = "If you change this, you must recreate “My Provider” and exchange the metadata with the other provider (IdP or SP)."|t(plugin.handle) %}

    {{ forms.autosuggestField({
        label: "Default Entity ID"|t(plugin.handle ),
        name:'entityId',
        id:'entityId',
        first: true,
        instructions: "The unique ID for the site."|t(plugin.handle),
        warning: warning,
        suggestEnvVars: true,
        suggestAliases: true,
        value: settings.entityIdRaw,
    }) }}

    {{ forms.autosuggestField({
        label: "SSO Endpoint Prefix"|t(plugin.handle ),
        name:'endpointPrefix',
        id:'endpointPrefix',
        instructions: "The URL prefix for the SSO endpoints."|t(plugin.handle),
        warning: warning,
        suggestEnvVars: true,
        value: settings.endpointPrefix,
    }) }}
{% endblock %}
