{
    "name": "flipboxfactory/saml-core",
    "description": "SAML SSO Core",
    "version": "6.0.0-beta.2",
    "type": "library",
    "keywords": [
        "cms",
        "craftcms",
        "saml",
        "service provider",
        "federated authentication",
        "sso",
        "laravel"
    ],
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-beta.2",
        "flipboxfactory/keychain": "^6.0.0-beta.1",
        "simplesamlphp/saml2": "~4.19.7"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "flipbox\\saml\\core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "flipbox\\saml\\core\\tests\\fixtures\\plugin\\": "tests/fixtures/plugin/src/",
            "flipbox\\saml\\core\\tests\\": "tests/",
            "CraftCms\\Cms\\Database\\Factories\\": "vendor/craftcms/cms/database/Factories/"
        }
    },
    "scripts": {
        "test": "pest",
        "check-cs": "pint --test",
        "fix-cs": "pint",
        "phpstan": "phpstan --memory-limit=1G",
        "check": [
            "@check-cs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "support": {
        "email": "support@flipboxfactory.com",
        "issues": "https://github.com/flipboxfactory/saml-core/issues?state=open",
        "source": "https://github.com/flipboxfactory/saml-core",
        "docs": "https://github.com/flipboxfactory/saml-core",
        "rss": "https://github.com/flipboxfactory/saml-core/commits/master.atom"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
