{
    "name": "flipboxfactory/saml-core",
    "description": "SAML SSO Core",
    "version": "5.0.11",
    "type": "library",
    "keywords": [
        "cms",
        "craftcms",
        "saml",
        "service provider",
        "federated authentication",
        "sso",
        "yii2"
    ],
    "require": {
        "craftcms/cms": "^5.0",
        "simplesamlphp/saml2": "~4.19.4",
        "flipboxfactory/keychain": "^5.0.0"
    },
    "require-dev": {
        "codeception/codeception": "^5.2",
        "codeception/module-asserts": "^3.0",
        "codeception/module-yii2": "^1.1.9",
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "vlucas/phpdotenv": "^5.4",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "flipbox\\saml\\core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "flipbox\\saml\\core\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "codecept run unit",
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "check": [
            "@check-cs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "support": {
        "email": "support@flipboxfactory.com",
        "issues": "https://github.com/flipboxfactory/saml-core/issues?state=open",
        "source": "https://github.com/flipboxfactory/saml-core",
        "docs": "https://github.com/flipboxfactory/saml-core",
        "rss": "https://github.com/flipboxfactory/saml-core/commits/master.atom"
    }
}
