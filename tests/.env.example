# Copy to tests/.env for local runs (CI copies it as-is). Values in tests/.env override
# environment variables, so edit the file rather than exporting CRAFT_DB_*.
CRAFT_DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=saml_core_test"
CRAFT_DB_USER="root"
CRAFT_DB_PASSWORD="password"
CRAFT_DB_SCHEMA=""
CRAFT_DB_TABLE_PREFIX=""
CRAFT_SECURITY_KEY="saml-core-test-security-key"
